# Frontend Razorpay Public Key (Safe for client bundle)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Backend API URL (Vercel deployment or custom domain)
VITE_API_BASE_URL=https://your-backend.vercel.app

# Local dev server Razorpay keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# WooCommerce & WordPress Environments (Staging vs Production)
# ==============================================================================
TARGET_ENV=staging

# Staging Environment Configuration
WP_STAGING_URL=https://mintcream-antelope-246402.hostingersite.com
WP_STAGING_USER=your_staging_wp_user
WP_STAGING_APP_PASSWORD=your_staging_wp_app_password

# Production (Live) Environment Configuration
WP_PROD_URL=https://viyonadesigns.com
WP_PROD_USER=your_prod_wp_user
WP_PROD_APP_PASSWORD=your_prod_wp_app_password

# Safety Guard: Set to true only during approved production deployment operations
ALLOW_PROD_MUTATION=false

# Tracking & Analytics
META_PIXEL_ID=1367098485202863
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
